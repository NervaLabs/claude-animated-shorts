9, "e": 23.584}, {"w": "Even", "s": 23.704, "e": 24.078}, {"w": "stranger,", "s": 24.078, "e": 24.939}, {"w": "the", "s": 24.939, "e": 25.238}, {"w": "blades", "s": 25.238, "e": 25.762}, {"w": "were", "s": 25.762, "e": 26.137}, {"w": "coated", "s": 26.137, "e": 26.661}, {"w": "in", "s": 26.661, "e": 26.885}, {"w": "a", "s": 26.885, "e": 27.035}, {"w": "thin", "s": 27.035, "e": 27.409}, {"w": "layer", "s": 27.409, "e": 27.859}, {"w": "of", "s": 27.859, "e": 28.083}, {"w": "chromium", "s": 28.083, "e": 28.757}, {"w": "oxide,", "s": 28.757, "e": 29.393}, {"w": "a", "s": 29.393, "e": 29.543}, {"w": "rust-proofing", "s": 29.543, "e": 30.591}, {"w": "technique", "s": 30.591, "e": 31.34}, {"w": "modern", "s": 31.34, "e": 31.864}, {"w": "industry", "s": 31.864, "e": 32.538}, {"w": "didn't", "s": 32.538, "e": 32.987}, {"w": "patent", "s": 32.987, "e": 33.511}, {"w": "until", "s": 33.511, "e": 33.96}, {"w": "the", "s": 33.96, "e": 34.26}, {"w": "20th", "s": 34.26, "e": 34.634}, {"w": "century.", "s": 34.634, "e": 35.42}, {"w": "After", "s": 35.54, "e": 36.002}, {"w": "2,200", "s": 36.002, "e": 36.387}, {"w": "years", "s": 36.387, "e": 36.848}, {"w": "underground,", "s": 36.848, "e": 37.964}, {"w": "several", "s": 37.964, "e": 38.579}, {"w": "swords", "s": 38.579, "e": 39.118}, {"w": "were", "s": 39.118, "e": 39.503}, {"w": "still", "s": 39.503, "e": 39.964}, {"w": "sharp", "s": 39.964, "e": 40.426}, {"w": "enough", "s": 40.426, "e": 40.964}, {"w": "to", "s": 40.964, "e": 41.195}, {"w": "slice", "s": 41.195, "e": 41.657}, {"w": "paper.", "s": 41.657, "e": 42.311}], "sentences": [{"text": "Did you know the 8,000 clay soldiers guarding China's first emperor weren't carrying prop weapons?", "s": 0.05, "e": 7.054}, {"text": "When farmers discovered the Terracotta Army in 1974, archaeologists realized every statue had a unique face, hairstyle, and armor, and held real, battle-ready bronze swords, spears, and crossbows.", "s": 7.234, "e": 23.584}, {"text": "Even stranger, the blades