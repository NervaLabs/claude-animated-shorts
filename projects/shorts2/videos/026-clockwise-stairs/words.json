ed", "s": 19.582, "e": 20.08}, {"w": "against", "s": 20.08, "e": 20.578}, {"w": "the", "s": 20.578, "e": 20.827}, {"w": "tight", "s": 20.827, "e": 21.2}, {"w": "central", "s": 21.2, "e": 21.697}, {"w": "stone", "s": 21.697, "e": 22.071}, {"w": "pillar,", "s": 22.071, "e": 22.662}, {"w": "making", "s": 22.662, "e": 23.097}, {"w": "it", "s": 23.097, "e": 23.284}, {"w": "nearly", "s": 23.284, "e": 23.719}, {"w": "impossible", "s": 23.719, "e": 24.404}, {"w": "to", "s": 24.404, "e": 24.59}, {"w": "swing.", "s": 24.59, "e": 25.119}, {"w": "Meanwhile,", "s": 25.239, "e": 26.093}, {"w": "defenders", "s": 26.093, "e": 26.776}, {"w": "fighting", "s": 26.776, "e": 27.391}, {"w": "from", "s": 27.391, "e": 27.732}, {"w": "above", "s": 27.732, "e": 28.142}, {"w": "had", "s": 28.142, "e": 28.416}, {"w": "wide", "s": 28.416, "e": 28.757}, {"w": "open", "s": 28.757, "e": 29.099}, {"w": "space", "s": 29.099, "e": 29.509}, {"w": "on", "s": 29.509, "e": 29.713}, {"w": "their", "s": 29.713, "e": 30.123}, {"w": "right", "s": 30.123, "e": 30.533}, {"w": "side", "s": 30.533, "e": 30.875}, {"w": "to", "s": 30.875, "e": 31.08}, {"w": "slash", "s": 31.08, "e": 31.49}, {"w": "downward", "s": 31.49, "e": 32.104}, {"w": "freely.", "s": 32.104, "e": 32.753}, {"w": "Even", "s": 32.873, "e": 33.168}, {"w": "the", "s": 33.168, "e": 33.404}, {"w": "step", "s": 33.404, "e": 33.699}, {"w": "heights", "s": 33.699, "e": 34.171}, {"w": "were", "s": 34.171, "e": 34.466}, {"w": "made", "s": 34.466, "e": 34.761}, {"w": "uneven", "s": 34.761, "e": 35.174}, {"w": "to", "s": 35.174, "e": 35.351}, {"w": "trip", "s": 35.351, "e": 35.646}, {"w": "intruders", "s": 35.646, "e": 36.236}, {"w": "in", "s": 36.236, "e": 36.413}, {"w": "the", "s": 36.413, "e": 36.649}, {"w": "dark.", "s": 36.649, "e": 37.092}], "sentences": [{"text": "Did you know medieval castle staircases were deliberately designed to give defenders a deadly advantage?", "s": 0.05, "e": 7.631}, {"text": "Almost every stone spiral staircase in a medieval tower curves clockwise as you go up.", "s": 7.811, "e": 14.33}, {"text": "Since most warriors were right-handed, attackers climbing up had their sword arm trapped against the tight central stone pillar, making it nearly impossible to swing.", "s": 14.45, "e": 25.119}, {"text": "Meanwhile, defenders fighting from above had wide open space on their right side to slash downward freely.", "s": 25.239, "e": 32.753}, {"text": "Even the step heights were made uneven to trip intruders in the dark.", "s": 32.873, "e": 37.092}]}