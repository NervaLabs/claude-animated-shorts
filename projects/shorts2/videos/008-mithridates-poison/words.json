"w": "completely,", "s": 40.276, "e": 41.192}, {"w": "forcing", "s": 41.192, "e": 41.734}, {"w": "him", "s": 41.734, "e": 42.005}, {"w": "to", "s": 42.005, "e": 42.209}, {"w": "ask", "s": 42.209, "e": 42.48}, {"w": "a", "s": 42.48, "e": 42.615}, {"w": "guard", "s": 42.615, "e": 43.022}, {"w": "to", "s": 43.022, "e": 43.226}, {"w": "use", "s": 43.226, "e": 43.497}, {"w": "a", "s": 43.497, "e": 43.632}, {"w": "sword.", "s": 43.632, "e": 44.209}], "sentences": [{"text": "Did you know an ancient king spent his whole life drinking poison so he couldn't be assassinated?", "s": 0.05, "e": 6.091}, {"text": "After his father was murdered by poisoning, King Mithridates the Sixth of Pontus became obsessed with immunity.", "s": 6.271, "e": 13.951}, {"text": "Every single day, he drank tiny, non-lethal doses of dozens of deadly toxins, from snake venom to arsenic, gradually increasing his tolerance.", "s": 14.071, "e": 25.533}, {"text": "His plan worked too well.", "s": 25.653, "e": 27.262}, {"text": "Decades later, when Roman forces cornered him in his palace, Mithridates tried to take his own life with poison to avoid capture.", "s": 27.382, "e": 36.529}, {"text": "Because of his lifelong immunity, the poison failed completely, forcing him to ask a guard to use a sword.", "s": 36.649, "e": 44.209}]}